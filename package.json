{
  "name": "@wess2001/velocity",
  "version": "0.2.0",
  "description": "Find performance risks, measure real behavior, and prevent regressions in JavaScript and TypeScript projects.",
  "type": "module",
  "bin": {
    "velocity": "./bin/velocity.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "bin",
    "src",
    "docs",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70",
    "lint": "eslint bin src test examples eslint.config.js",
    "typecheck": "tsc --noEmit --allowJs --checkJs --module NodeNext --moduleResolution NodeNext --target ES2022 src/index.js src/index.d.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && node bin/velocity.js check . --no-color",
    "demo": "node bin/velocity.js analyze examples/problematic-api --no-color",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "performance",
    "javascript",
    "typescript",
    "profiling",
    "benchmark",
    "cli"
  ],
  "license": "MIT",
  "author": "WessYu",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WessYu/velocity.git"
  },
  "homepage": "https://github.com/WessYu/velocity#readme",
  "bugs": {
    "url": "https://github.com/WessYu/velocity/issues"
  },
  "dependencies": {
    "@babel/parser": "^7.28.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.2"
  }
}
