{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/WessYu/velocity/main/schemas/load-report.schema.json",
  "title": "Velocity browser load report",
  "type": "object",
  "required": ["schemaVersion", "kind", "url", "device", "runs", "methodology", "environment", "samples", "metrics", "measured", "unstable", "recommendations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "load" },
    "device": { "enum": ["mobile", "desktop"] },
    "url": { "type": "string", "format": "uri" },
    "runs": { "type": "integer", "minimum": 1, "maximum": 10 },
    "methodology": {
      "type": "object",
      "required": ["protocol", "browser", "browserVersion", "browserMajorVersion", "userAgent", "viewport", "throttling", "visualProgressIndex", "tbt", "ignoreHTTPSErrors"],
      "properties": {
        "protocol": { "const": "velocity-load-v2" },
        "browser": { "const": "Chromium" },
        "browserVersion": { "type": ["string", "null"] },
        "browserMajorVersion": { "type": ["integer", "null"], "minimum": 1 },
        "userAgent": { "type": ["string", "null"] },
        "viewport": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
        "throttling": { "type": ["object", "null"] },
        "visualProgressIndex": { "type": ["string", "null"] },
        "tbt": { "type": "string", "minLength": 1 },
        "ignoreHTTPSErrors": { "type": "boolean" }
      }
    },
    "environment": { "type": "object" },
    "samples": { "type": "array", "minItems": 1 },
    "metrics": { "type": "object" },
    "measured": {
      "type": "object",
      "required": ["fcpMs", "lcpMs", "cls", "tbtMs", "visualProgressIndexMs", "ttfbMs", "requests", "transferBytes"],
      "properties": {
        "fcpMs": { "$ref": "#/$defs/nullableNumber" },
        "lcpMs": { "$ref": "#/$defs/nullableNumber" },
        "cls": { "$ref": "#/$defs/nullableNumber" },
        "tbtMs": { "$ref": "#/$defs/nullableNumber" },
        "visualProgressIndexMs": { "$ref": "#/$defs/nullableNumber" },
        "ttfbMs": { "$ref": "#/$defs/nullableNumber" },
        "requests": { "$ref": "#/$defs/nullableNumber" },
        "transferBytes": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "unstable": { "type": "boolean" },
    "recommendations": { "type": "array", "items": { "type": "object", "properties": { "measured": { "const": false } } } }
  },
  "$defs": { "nullableNumber": { "type": ["number", "null"], "minimum": 0 } }
}
